bridge.voltminer.net {
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
			dial_timeout 10s
			keepalive 30s
		}
	}
}

web.voltminer.net {
	root * /var/www/voltminer-web
	# Caddy's default encode matcher is a list of TEXT-BASED types only
	# (text/*, application/json*, javascript*, xhtml/atom/rss+xml, image/svg+xml),
	# so application/wasm was silently skipped and the 102 KB wasm shipped
	# uncompressed — a third of the first-visit weight. `match` REPLACES the
	# default, so this restates it and adds wasm. Repeated `header` lines for the
	# same field are OR'ed, not AND'ed (caddyhttp/matchers.go), so this is a union.
	encode gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
			header Content-Type application/wasm*
		}
	}

	# Same-origin relay: the browser opens ONE socket, to the host it already
	# trusts, so the CSP can say connect-src 'self'. Origin-locked upstream.
	reverse_proxy /stratum* 127.0.0.1:8787 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
			dial_timeout 10s
			keepalive 30s
		}
	}

	header {
		# No third-party script, font, frame, form or socket. Proof, not promise.
		# manifest-src is listed because `default-src 'none'` would otherwise block
		# the web app manifest, and without the manifest there is no install.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# The service worker must never be served stale: a bad build that caches itself
	# would be pinned on every installed device with no way back. The manifest and
	# the HTML are no-cache for the same reason — the update story is "network-first
	# navigation, so what you read is what is deployed".
	header /sw.js Cache-Control "no-store, must-revalidate"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	header /manifest.webmanifest Cache-Control "no-cache"
	header /*.html Cache-Control "no-cache"
	header / Cache-Control "no-cache"
	# Ops health alias: the relay only answers "/health" exactly, and the proxied
	# path keeps its /stratum prefix, so health is exposed here instead. Lets the
	# bridge hostname be dropped later without losing the ops surface.
	handle /relay-health {
		rewrite * /health
		reverse_proxy 127.0.0.1:8787
	}

	header /js/vendor/randomx/*.wasm Content-Type application/wasm
	file_server
}
